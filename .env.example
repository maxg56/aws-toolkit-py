# AWS Configuration for aws-simple library

# Required: AWS Region
AWS_REGION=us-east-1

# Optional: AWS Profile (for local development with multiple profiles)
# AWS_PROFILE=my-profile

# Required: Default S3 bucket name
AWS_S3_BUCKET=my-bucket-name

# Optional: Textract-specific region (defaults to AWS_REGION)
# AWS_TEXTRACT_REGION=us-east-1

# Optional: Bedrock model ID (defaults to Claude 3.5 Sonnet)
# AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Optional: Bedrock-specific region (defaults to AWS_REGION)
# AWS_BEDROCK_REGION=us-east-1

# Optional: retry / timeout tuning (botocore Config), all with sane defaults
# AWS_MAX_ATTEMPTS=3
# AWS_RETRY_MODE=standard
# AWS_CONNECT_TIMEOUT=10
# AWS_READ_TIMEOUT=60

# Development only: SSL certificate verification (defaults to verification ON).
# Set to true to DISABLE verification -- only for a custom endpoint_url below
# (LocalStack/MinIO with a self-signed cert); it is refused outright against a
# real AWS endpoint. The legacy AWS_SSL_VERIFY=false still works for now (note
# the inverted polarity) but is deprecated.
# AWS_INSECURE_DISABLE_SSL_VERIFY=false

# Optional: Custom endpoint URL, applied to every service.
# Use it to target an AWS-compatible stack such as LocalStack or MinIO.
# AWS_ENDPOINT_URL=http://localhost:4566

# Optional: Per-service endpoint URLs (each defaults to AWS_ENDPOINT_URL)
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_TEXTRACT_ENDPOINT_URL=http://localhost:4566
# AWS_BEDROCK_ENDPOINT_URL=http://localhost:4566

# Optional: Explicit AWS credentials.
# Prefer an IAM role or ~/.aws/credentials whenever you can; these are meant
# for local stacks (LocalStack/MinIO) and for applications that manage their
# own credentials. AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY must both be
# set: a partial pair is ignored so the default credential chain keeps
# working. AWS_SESSION_TOKEN is only needed for temporary credentials.
# Never commit real values.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_SESSION_TOKEN=

# Note: when the variables above are unset, credentials are resolved by the
# default boto3 chain:
# - IAM Role (recommended for production/EC2/ECS/Lambda)
# - ~/.aws/credentials file (for local development)
# - AWS_PROFILE named profile
